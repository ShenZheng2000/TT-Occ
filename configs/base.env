# Base config. Children: source this file, then override.
# Paths
WORK_DIRS=/scratch/shenzhen/TT-Occ/work_dirs
FEATURE_ROOT=/scratch/shenzhen/TT-Occ/features
DATA_ROOT=/scratch/shenzhen/Datasets/nuscenes_extracted_val
OCC3D_PATH=/scratch/shenzhen/Datasets/Occ3D_nuscenes/gts/
NUCRAFT_PATH=/scratch/shenzhen/Datasets/nuCraft/occupancy@0.2/
# Models / knobs
VARIANT=Camera   # Camera or LIDAR
SEMANTIC_PREFIX=openseed
DEPTH_PREFIX=vggt
DYNAMIC_MASK_PREFIX=raft
# 3090 memory settings (run_main.sh default for SAM_BOX_BATCH is 1)
TTOCC_SAM_BOX_BATCH=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TTOCC_MAPANY_MEMORY_EFFICIENT=0
TTOCC_MAPANY_IGNORE_POSES=0
TTOCC_REX_THING_INSTANCES_ONLY=0
TTOCC_KEEP_BARRIER_TRAILER=0
USE_FUSION=0
